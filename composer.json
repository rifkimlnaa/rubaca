{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "library/perpustakaan-modern",
  "type": "project",
  "description": "Sistem perpustakaan modern berbasis Laravel 12",
  "keywords": ["laravel", "library", "perpustakaan"],
  "license": "MIT",
  "require": {"php": "^8.4", "laravel/framework": "^12.0", "laravel/tinker": "^2.10"},
  "require-dev": {"fakerphp/faker": "^1.23", "phpunit/phpunit": "^11.5", "nunomaduro/collision": "^8.6"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --seed", "npm install", "npm run build"],
    "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names=server,queue,vite"],
    "test": "@php artisan test",
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}